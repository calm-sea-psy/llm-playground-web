# 설정 예시. docker compose 는 .env 를, Vite 개발 서버는 .env · .env.local 을 읽는다.
# 바꿀 때만 이 파일을 .env(compose · 개발 서버 함께) 또는 .env.local(개발 서버만)로 복사해서 고친다 (.env · *.local 은 커밋하지 않는다).

# ---- 화면 (Vite. 빌드 때 화면에 박힌다) ----

# API 연결 방식: http = 실제 wiki, mock = 서버 없이 계약 예시(contracts/examples)를 재생하는 목업.
# 비우면 개발 서버(npm run dev)는 mock, 빌드(npm run build · docker)는 http 다.
VITE_API_MODE=

# API 주소 (http 모드). 비우면 같은 주소로 보낸다 — 개발 서버는 /health · /ask · /search 를 WIKI_URL 로,
# docker 의 nginx 는 BACKEND_URL 로 넘긴다. 다른 주소의 wiki 를 바로 부르면 wiki 에 CORS 설정이 없어 막힌다.
VITE_API_BASE=

# ---- 개발 서버 (npm run dev. 화면 코드에는 들어가지 않는다) ----

# 개발 서버 프록시가 넘길 wiki 주소. 비우면 http://127.0.0.1:8000
WIKI_URL=

# /ask 를 이만큼(ms) 늦게 넘긴다. 답을 기다리는 화면을 확인할 때만 쓴다
ASK_DELAY_MS=

# ---- docker compose ----

# 화면을 열 포트 → http://localhost:8080
WEB_PORT=8080

# nginx 가 /health · /ask · /search 를 넘길 wiki 주소.
# - 내 PC 에서 wiki 를 띄웠으면: http://host.docker.internal:8000 (wiki 를 --host 0.0.0.0 으로 띄워야 컨테이너에서 닿는다)
# - 같은 compose 네트워크의 서비스면: http://<서비스 이름>:8000
BACKEND_URL=http://host.docker.internal:8000

# Linux 에서 logs/ 폴더 소유자가 uid 1000 이 아니면 그 uid 로 바꾼다
LOG_UID=1000
