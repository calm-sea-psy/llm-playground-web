# docker compose 설정. 이 파일을 .env 로 복사해서 고친다 (.env 는 커밋하지 않는다).

# 화면을 열 포트 → http://localhost:8080
WEB_PORT=8080

# http = 실제 백엔드에 붙는다, mock = 서버 없이 목업으로 화면만 본다 (바꾸면 --build 필요)
VITE_API_MODE=http

# 백엔드 주소 (nginx 가 /health · /query 를 여기로 넘긴다)
# - 내 PC 에서 백엔드를 띄웠으면: http://host.docker.internal:8000
# - 같은 compose 네트워크의 백엔드 서비스면: http://<서비스 이름>:8000
BACKEND_URL=http://host.docker.internal:8000
